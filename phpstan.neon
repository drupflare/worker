parameters:
    level: 5
    paths:
        - src/site/php
    excludePaths:
        analyse:
            # read variables their includer defines, or hold a try whose body is a template token
            - src/site/php/boot/phase/container-unserialize.php
            - src/site/php/boot/phase/kernel-boot.php
            - src/site/php/boot/phase/kernel-new.php
            - src/site/php/boot/phase/pre-handle.php
            - src/site/php/boot/phase/render.php
            - src/site/php/cron-hook-list.php
            - src/site/php/pack/consistency-run.php
            - src/site/php/settings-override.php
            # drives a native PDO; the autoloaded rom shim declares a different PDO class
            - src/site/php/migrate-db.php
    treatPhpDocTypesAsCertain: false
    bootstrapFiles:
        - drupal-src/autoload.php
    scanFiles:
        - stubs/runtime.php
        - drupal-src/core/includes/common.inc
        - drupal-src/core/includes/install.core.inc
        - drupal-src/core/includes/install.inc
        - drupal-src/core/includes/update.inc
    scanDirectories:
        - drupal-src/core/modules/user/src
        - drupal-src/core/modules/node/src
        - drupal-src/core/modules/file/src
        - drupal-src/core/modules/path_alias/src
        - drupal-src/core/modules/sqlite/src
        - ../drupflare/src
        - ../rom/src/Driver
