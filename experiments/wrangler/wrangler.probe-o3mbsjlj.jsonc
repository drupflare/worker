{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "drupal-cfw-probe-o3mbsjlj",
	"main": "../probe-o3mbsjlj.ts",
	"vars": { "PW_DIAGNOSTICS": "1" },
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"rules": [
		{
			"type": "CompiledWasm",
			"globs": ["**/*.wasm"],
			"fallthrough": true
		}
	],
	"assets": {
		"directory": "../../assets",
		"binding": "ASSETS"
	}
}
