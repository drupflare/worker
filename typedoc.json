{
	"$schema": "https://typedoc.org/schema.json",
	"entryPointStrategy": "expand",
	"entryPoints": ["src"],
	"exclude": ["**/*.d.ts", "src/probes/**", "src/drupal/*-php.ts", "src/runtime/php-binary*.ts"],
	"out": "typedoc/api",
	"name": "drupflare/worker",
	"readme": "none",
	"includeVersion": true,
	"excludeInternal": true,
	"excludePrivate": true,
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"notDocumented": true
	},
	"treatWarningsAsErrors": false
}
