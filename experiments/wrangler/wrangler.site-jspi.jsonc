{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cfw-site-jspi",
  "main": "../../src/site.ts",
  "vars": {
    "PW_DIAGNOSTICS": "1",
    "RENDER_BUDGET_MS": "2000",
    "GEN_BUCKET_MS": "5000"
  },
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE",
        "class_name": "SitePhpDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SitePhpDurableObject"
      ]
    }
  ],
  "assets": {
    "directory": "../../assets",
    "binding": "ASSETS"
  },
  "alias": {
    "./runtime/php-binary.js": "../../src/runtime/php-binary-jspi.ts"
  }
}