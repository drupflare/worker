{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "cfw-opc",
	"main": "../../src/site.ts",
	"minify": true,
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"vars": {
		"CMS": "drupal",
		"LAZY_MOUNT": "1",
		"LAZY_FS_BUDGET_BYTES": "4194304",
		"GEN_BUCKET_MS": "5000",
		"PLAN": "paid",
		"PW_DIAGNOSTICS": "1",
		"SITE_WARM": "0",
		"RETAIN_INTERPRETER": "0"
	},
	"rules": [
		{
			"type": "CompiledWasm",
			"globs": ["**/*.wasm"],
			"fallthrough": true
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "SITE", "class_name": "SitePhpDurableObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SitePhpDurableObject"] }],
	"assets": {
		"directory": "../../assets",
		"binding": "ASSETS"
	},
	"observability": { "enabled": true },
	"alias": {
		"./runtime/php-binary.js": "../../src/runtime/php-binary-raw.ts"
	}
}
