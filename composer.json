{
	"name": "drupflare/worker",
	"description": "Drupal 11 on Cloudflare Workers: PHP as WebAssembly inside a Durable Object",
	"type": "project",
	"license": "MIT",
	"authors": [
		{
			"name": "Gregory Mitchell",
			"email": "me@gmitch215.xyz"
		}
	],
	"repositories": [
		{
			"type": "composer",
			"url": "https://packages.drupal.org/8"
		}
	],
	"require": {
		"php": ">=8.3",
		"composer/installers": "^2.3",
		"drupal/admin_toolbar": "^3.6",
		"drupal/core-composer-scaffold": "^11.4",
		"drupal/core-project-message": "^11.4",
		"drupal/core-recipe-unpack": "^11.4",
		"drupal/core-recommended": "^11.4",
		"drupal/core-vendor-hardening": "^11.4",
		"drupal/ctools": "^4.1",
		"drupal/pathauto": "^1.15",
		"drupal/token": "^1.17",
		"drupflare/drupflare": "0.*",
		"drupflare/rom": "0.*"
	},
	"config": {
		"sort-packages": true,
		"vendor-dir": ".composer-vendor",
		"allow-plugins": {
			"composer/installers": false,
			"drupal/core-composer-scaffold": false,
			"drupal/core-project-message": false,
			"drupal/core-recipe-unpack": false,
			"drupal/core-vendor-hardening": false,
			"symfony/runtime": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"require-dev": {
		"phpstan/phpstan": "^2.2"
	},
	"scripts": {
		"analyze": "phpstan analyse --memory-limit=1G"
	},
	"scripts-descriptions": {
		"analyze": "Runs PHPStan over scripts/ at the level pinned in phpstan.neon. Needs the Drupal tree: bun run fetch:drupal."
	}
}
