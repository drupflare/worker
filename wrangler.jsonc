{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "drupflare",
	"main": "src/site.ts",
	"minify": true,
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"LAZY_MOUNT": "1",
		"LAZY_FS_BUDGET_BYTES": "4194304",
		"GEN_BUCKET_MS": "5000",
		"PLAN": "free"
	},
	"rules": [
		{
			"type": "CompiledWasm",
			"globs": ["**/*.wasm"],
			"fallthrough": true
		},
		{
			"type": "Data",
			"globs": ["**/*.zst", "**/*.br"],
			"fallthrough": true
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "SITE", "class_name": "SitePhpDurableObject" }]
	},
	"kv_namespaces": [{ "binding": "CONFIG_KV" }],
	"d1_databases": [{ "binding": "FLEET_DB", "database_name": "drupflare-fleet" }],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SitePhpDurableObject"] }],
	"assets": {
		"directory": "./assets",
		"binding": "ASSETS"
	},
	"triggers": { "crons": ["*/5 * * * *"] },
	"observability": { "enabled": true },
	"alias": {
		"./runtime/php-binary.js": "./src/runtime/php-binary-85.ts"
	}
}
